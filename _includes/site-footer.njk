
  {% assign footer_page = page.fileSlug | default: "index" %}
  <footer class="py-5">
    <div class="container-xl px-4">
      <div class="row g-5 pb-5 border-bottom border-white border-opacity-10">
        <div class="col-lg-6"><img src="images/1402298121.png" alt="Yaquina Bay Yacht Club" class="footer-logo">
          <p class="mt-4 mb-0 lh-lg" style="max-width:420px">Promoting safe water sports and recreation in a friendly atmosphere since 1947.</p>
        </div>
        <div class="col-sm-6 col-lg-3">
          <p class="hero-kicker text-warning">Visit</p>
          <address class="lh-lg">750 SE Bay Blvd.<br>Newport, Oregon 97365</address>
          <a href="https://maps.google.com/?q=750+SE+Bay+Blvd+Newport+Oregon+97365">Directions ↗</a>
        </div>
        <div class="col-sm-6 col-lg-3">
          <p class="hero-kicker text-warning">{{ footer_links.pages[footer_page].title | default: "Explore" }}</p>
          <div class="d-grid gap-2">
          {% for link in footer_links.pages[footer_page].items %}
            <a href="{{ link.href }}">{{ link.text }}</a>
          {% endfor %}
          </div>
        </div>
      </div>
      <div class="d-flex justify-content-between gap-2 pt-4 small">
        <span>© <span id="year">2026</span> Yaquina Bay Yacht Club</span><span>Newport, Oregon</span>
      </div>
    </div>
  </footer>

<figure class="{{ gallery_figure_class }}"><div id="{{ gallery_id }}" class="carousel slide{% if gallery_fade %} carousel-fade{% endif %} {{ gallery_carousel_class }}" data-bs-ride="carousel" data-bs-interval="{{ gallery_interval }}">
  <div class="carousel-inner">{% for photo in gallery.photos %}
    <div class="carousel-item{% if forloop.first %} active{% endif %}"><img src="{{ photo.url | escape }}" alt="{{ photo.alt | escape }}" title="{{ photo.alt | escape }}"{% unless forloop.first %} loading="lazy"{% endunless %}>{% if photo.caption %}<div class="carousel-caption"><p>{{ photo.caption }}</p>{% if gallery_inline_credit and gallery.copyright %}<span class="carousel-credit">{{ gallery.copyright }}</span>{% endif %}</div>{% endif %}</div>{% endfor %}
  </div>
  {% if gallery_show_indicators %}<div class="carousel-indicators">{% for photo in gallery.photos %}<button type="button" data-bs-target="#{{ gallery_id }}" data-bs-slide-to="{{ forloop.index0 }}"{% if forloop.first %} class="active" aria-current="true"{% endif %} aria-label="{% if photo.caption %}{{ photo.caption | escape }}{% else %}Photo {{ forloop.index }}{% endif %}"></button>{% endfor %}</div>{% endif %}
  <button class="carousel-control-prev" type="button" data-bs-target="#{{ gallery_id }}" data-bs-slide="prev"><span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Previous</span></button><button class="carousel-control-next" type="button" data-bs-target="#{{ gallery_id }}" data-bs-slide="next"><span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Next</span></button>
</div>{% if gallery.caption %}<figcaption class="media-caption"><span>{{ gallery.caption }}</span>{% if gallery.copyright %}<span class="caption-credit">{{ gallery.copyright }}</span>{% endif %}</figcaption>{% elsif gallery.copyright and not gallery_inline_credit %}<figcaption class="media-credit">{{ gallery.copyright }}</figcaption>{% endif %}</figure>
